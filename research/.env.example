# Copy to .env and fill in. See README.md (API keys) for what each is used for.

# --- System-1 decision models -------------------------------------------------
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
OPENJEV_BASE_URL=http://localhost:8080
OPENJEV_API_KEY=
# OPENJEV_MODEL=openjev-latest

# --- System-2 LLMs --------------------------------------------------------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# --- self-hosted open models (vLLM / SGLang OpenAI-compatible server) ------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY

# --- infra ----------------------------------------------------------------------
HF_TOKEN=
WANDB_API_KEY=
